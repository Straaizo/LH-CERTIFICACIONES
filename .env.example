# Copiar como .env.development (local) o .env.production (publicación). Nunca subir los .env reales.

# Dirección de la API. En desarrollo debe ser localhost.
VITE_API_URL=http://localhost:8080

# demo: se elige un usuario de prueba al ingresar | firebase: correo y contraseña
VITE_AUTH_MODO=demo

# Solo con VITE_AUTH_MODO=firebase
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
